+void ggml_vec_dot_ptq1_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+#if defined(__AVX2__)
+    const int nb = n / QK_PTQ1_0;
+
+    assert(n % QK_PTQ1_0 == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_ptq1_0 * GGML_RESTRICT x = vx;
+    const block_q8_0   * GGML_RESTRICT y = vy;
+    static const uint8_t pow3[5] = {1, 3, 9, 27, 81};
+    const __m256i ones = _mm256_set1_epi16(1);
+    const __m256i mask8_256 = _mm256_set1_epi16(0xff);
+    const __m256i three_256 = _mm256_set1_epi16(3);
+    const __m128i mask8_128 = _mm_set1_epi16(0xff);
+    const __m128i three_128 = _mm_set1_epi16(3);
+    const __m128i one8 = _mm_set1_epi8(1);
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; ++i) {
+        int8_t q[QK_PTQ1_0];
+        const __m256i src16 = _mm256_cvtepu8_epi16(_mm_loadu_si128((const __m128i *) x[i].qs));
+        const __m128i src8 = _mm_cvtepu8_epi16(_mm_loadl_epi64((const __m128i *) (x[i].qs + 16)));
+        for (int nn = 0; nn < 5; ++nn) {
+            __m256i codes16 = _mm256_and_si256(_mm256_mullo_epi16(src16, _mm256_set1_epi16(pow3[nn])), mask8_256);
+            codes16 = _mm256_srli_epi16(_mm256_mullo_epi16(codes16, three_256), 8);
+            __m128i packed16 = _mm_packus_epi16(_mm256_castsi256_si128(codes16), _mm256_extracti128_si256(codes16, 1));
+            packed16 = _mm_sub_epi8(packed16, one8);
+            _mm_storeu_si128((__m128i *) (q + nn * 16), packed16);
+        }
+        for (int nn = 0; nn < 5; ++nn) {
+            __m128i codes8 = _mm_and_si128(_mm_mullo_epi16(src8, _mm_set1_epi16(pow3[nn])), mask8_128);
+            codes8 = _mm_srli_epi16(_mm_mullo_epi16(codes8, three_128), 8);
+            const __m128i packed8 = _mm_sub_epi8(_mm_packus_epi16(codes8, _mm_setzero_si128()), one8);
+            _mm_storel_epi64((__m128i *) (q + 80 + nn * 8), packed8);
+        }
+        for (int nn = 0; nn < 4; ++nn) {
+            for (size_t h = 0; h < sizeof(x->qh); ++h) {
+                const uint8_t v = x[i].qh[h] * pow3[nn];
+                const int16_t xi = ((uint16_t) v * 3) >> 8;
+                q[120 + nn * sizeof(x->qh) + h] = (int8_t) (xi - 1);
+            }
+        }
+
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        float sumi = 0.0f;
+        for (int k = 0; k < 4; ++k) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[i * 4 + k];
+            const float d1 = GGML_CPU_FP16_TO_FP32(yb->d);
+            const __m256i qx = _mm256_loadu_si256((const __m256i *) (q + k * 32));
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) yb->qs);
+            const int sumi_block = hsum_i32_8(_mm256_madd_epi16(mul_add_epi8(qx, qy), ones));
+            sumi += d1 * sumi_block;
+        }
+        sumf += d0 * sumi;
+    }
+
+    *s = sumf;
+#else
+    ggml_vec_dot_ptq1_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
 void ggml_vec_dot_pq2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     const int qk = QK_PQ2_0;
     const int nb = n / qk;
