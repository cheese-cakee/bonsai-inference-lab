diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index 7fc8e771..c8a396b1 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -558,6 +558,93 @@ static inline __m128i get_scale_shuffle(int i) {
 #  define GGML_DPBUSD_256 _mm256_dpbusd_avx_epi32
 #endif
 
+#if defined(__AVX2__)
+// PTQ1_0 packs five base-3 digits per byte. Digit nn of byte b is
+// ((uint8_t)(b * 3^nn) * 3) >> 8; subtracting 1 maps {0,1,2} to {-1,0,+1}.
+// These helpers apply that to 16 or 8 bytes widened to 16-bit lanes.
+static inline __m128i ptq1_digits_16(const __m256i bytes16, const int16_t pow3) {
+    const __m256i low8 = _mm256_and_si256(_mm256_mullo_epi16(bytes16, _mm256_set1_epi16(pow3)), _mm256_set1_epi16(0xff));
+    const __m256i digit = _mm256_srli_epi16(_mm256_mullo_epi16(low8, _mm256_set1_epi16(3)), 8);
+    const __m128i packed = _mm_packus_epi16(_mm256_castsi256_si128(digit), _mm256_extracti128_si256(digit, 1));
+    return _mm_sub_epi8(packed, _mm_set1_epi8(1));
+}
+
+static inline __m128i ptq1_digits_8(const __m128i bytes8, const __m128i pow3) {
+    const __m128i low8 = _mm_and_si128(_mm_mullo_epi16(bytes8, pow3), _mm_set1_epi16(0xff));
+    const __m128i digit = _mm_srli_epi16(_mm_mullo_epi16(low8, _mm_set1_epi16(3)), 8);
+    return _mm_sub_epi8(_mm_packus_epi16(digit, _mm_setzero_si128()), _mm_set1_epi8(1));
+}
+#endif
+
+void ggml_vec_dot_ptq1_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+#if defined(__AVX2__)
+    const int nb = n / QK_PTQ1_0;
+
+    assert(n % QK_PTQ1_0 == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_ptq1_0 * GGML_RESTRICT x = vx;
+    const block_q8_0   * GGML_RESTRICT y = vy;
+    const __m256i ones = _mm256_set1_epi16(1);
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; ++i) {
+        // Weight order matches the generic decoder: digits 0-4 of qs[0..15],
+        // then digits 0-4 of qs[16..23], then digits 0-3 of qh[0..1].
+        const __m256i qs16 = _mm256_cvtepu8_epi16(_mm_loadu_si128((const __m128i *) x[i].qs));
+        const __m128i qs8  = _mm_cvtepu8_epi16(_mm_loadl_epi64((const __m128i *) (x[i].qs + 16)));
+        const __m128i qh8  = _mm_setr_epi16(x[i].qh[0], x[i].qh[1], x[i].qh[0], x[i].qh[1],
+                                            x[i].qh[0], x[i].qh[1], x[i].qh[0], x[i].qh[1]);
+
+        const __m128i a0 = ptq1_digits_16(qs16, 1);
+        const __m128i a1 = ptq1_digits_16(qs16, 3);
+        const __m128i a2 = ptq1_digits_16(qs16, 9);
+        const __m128i a3 = ptq1_digits_16(qs16, 27);
+        const __m128i a4 = ptq1_digits_16(qs16, 81);
+        const __m128i b0 = ptq1_digits_8(qs8, _mm_set1_epi16(1));
+        const __m128i b1 = ptq1_digits_8(qs8, _mm_set1_epi16(3));
+        const __m128i b2 = ptq1_digits_8(qs8, _mm_set1_epi16(9));
+        const __m128i b3 = ptq1_digits_8(qs8, _mm_set1_epi16(27));
+        const __m128i b4 = ptq1_digits_8(qs8, _mm_set1_epi16(81));
+        const __m128i h  = ptq1_digits_8(qh8, _mm_setr_epi16(1, 1, 3, 3, 9, 9, 27, 27));
+
+        const __m256i qx[4] = {
+            _mm256_set_m128i(a1, a0),
+            _mm256_set_m128i(a3, a2),
+            _mm256_set_m128i(_mm_unpacklo_epi64(b0, b1), a4),
+            _mm256_set_m128i(_mm_unpacklo_epi64(b4, h), _mm_unpacklo_epi64(b2, b3)),
+        };
+
+        __m256i dot[4];
+        for (int k = 0; k < 4; ++k) {
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) y[i * 4 + k].qs);
+            dot[k] = _mm256_madd_epi16(mul_add_epi8(qx[k], qy), ones);
+        }
+        // One reduction for all four 32-weight blocks: lane k holds block k's integer sum.
+        const __m256i pairs = _mm256_hadd_epi32(_mm256_hadd_epi32(dot[0], dot[1]), _mm256_hadd_epi32(dot[2], dot[3]));
+        int32_t sumi_block[4];
+        _mm_storeu_si128((__m128i *) sumi_block, _mm_add_epi32(_mm256_castsi256_si128(pairs), _mm256_extracti128_si256(pairs, 1)));
+
+        // Same float operations, in the same order, as the generic kernel.
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        float sumi = 0.0f;
+        for (int k = 0; k < 4; ++k) {
+            const float d1 = GGML_CPU_FP16_TO_FP32(y[i * 4 + k].d);
+            sumi += d1 * sumi_block[k];
+        }
+        sumf += d0 * sumi;
+    }
+
+    *s = sumf;
+#else
+    ggml_vec_dot_ptq1_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
 void ggml_vec_dot_pq2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     const int qk = QK_PQ2_0;
     const int nb = n / qk;
